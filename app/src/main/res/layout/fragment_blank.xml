<?xml version="1.0" encoding="utf-8"?>

<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/menu"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="☰"
                android:textSize="26sp"
                android:textColor="#465366" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/search"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⌕"
                android:textSize="30sp"
                android:textColor="#465366" />

            <TextView
                android:id="@+id/profile"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="👤"
                android:textSize="22sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Good morning 👋"
            android:textSize="13sp"
            android:textColor="#222222"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background"
                    android:padding="6dp"
                    android:text="kotlin-android studio"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#2463B5" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />





            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Learn Kotlin basics"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#202020" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="◷  6:00 – 9:00 PM"
                android:textSize="12sp"
                android:textColor="#777777" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="التاريخ: 01/10/2026"
                android:gravity="end"
                android:textSize="12sp"
                android:textColor="#777777" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:background="#EEEEEE" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="وصف المهمة"
                android:gravity="end"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="تعلّم أساسيات لغة كوتلن والمتغيرات."
                android:gravity="end"
                android:textSize="12sp"
                android:textColor="#888888" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/startTask1"
                    android:layout_width="100dp"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:background="@drawable/brown"
                    android:text="ابدأ المهمة"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />




            </LinearLayout>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background"
                    android:padding="6dp"
                    android:text="kotlin-android studio"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#2463B5" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />



            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Learn Database"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#202020" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="◷  7:00 – 10:00 PM"
                android:textSize="12sp"
                android:textColor="#777777" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="التاريخ: 03/10/2026"
                android:gravity="end"
                android:textSize="12sp"
                android:textColor="#777777" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:background="#EEEEEE" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="وصف المهمة"
                android:gravity="end"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="تعلّم أساسيات إنشاء واستخدام قواعد البيانات."
                android:gravity="end"
                android:textSize="12sp"
                android:textColor="#888888" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/startTask2"
                    android:layout_width="100dp"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:background="@drawable/brown"
                    android:text="ابدأ المهمة"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />




            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/tasksContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <Button
            android:id="@+id/addTask"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end"
            android:layout_marginTop="24dp"
            android:background="@drawable/brown"
            android:text="+"
            android:textSize="30sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    </ScrollView>

</android.support.constraint.ConstraintLayout>
